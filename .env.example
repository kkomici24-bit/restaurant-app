# Kopjoje në .env dhe rregulloji vlerat lokale
ADMIN_PASS=admin123
SESSION_SECRET=ndrysho_sesiune_sekret
PORT=3000
BASE_URL=http://localhost:3000
# Email (SMTP)
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
