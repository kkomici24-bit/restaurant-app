<%- include('partials/header') %>

<div class="jumbotron p-5 text-white rounded" style="background-image: url('https://images.unsplash.com/photo-1528605248644-14dd04022da1?auto=format&fit=crop&w=1600&q=80'); background-size: cover;">
  <div class="bg-dark bg-opacity-50 p-4 rounded">
    <h1 class="display-4">Restorant Tirana</h1>
    <p class="lead">Meny moderne, rezervime online dhe aktivitete të bukura.</p>
    <p>
      <a class="btn btn-primary btn-lg" href="/menu">Shiko Menunë</a>
      <a class="btn btn-outline-light btn-lg" href="/reservations">Rezervo Tani</a>
    </p>
  </div>
</div>

<section class="my-5">
  <h2 class="mb-3">Pjatat e fundit</h2>
  <div class="row">
    <% items.forEach(function(item){ %>
      <div class="col-md-4 mb-4">
        <div class="card h-100">
          <img src="<%= item.image %>" class="card-img-top" alt="<%= item.name %>">
          <div class="card-body">
            <h5 class="card-title"><%= item.name %></h5>
            <p class="card-text"><%= item.description %></p>
          </div>
          <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="fw-bold"><%= item.price %> €</span>
            <a href="/menu" class="btn btn-sm btn-primary">Më shumë</a>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<section class="my-5">
  <h2 class="mb-3">Aktivitete të ardhshme</h2>
  <div class="row">
    <% events.forEach(function(e){ %>
      <div class="col-md-6 mb-4">
        <div class="card">
          <img src="<%= e.image %>" class="card-img-top" alt="<%= e.title %>">
          <div class="card-body">
            <h5><%= e.title %></h5>
            <p><%= e.description %></p>
            <small class="text-muted"><%= e.date %> | <%= e.time %></small>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<%- include('partials/footer') %>
