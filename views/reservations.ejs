<%- include('partials/header') %>

<h1 class="mb-4">Rezervime</h1>
<form id="reservationForm" class="row g-3">
  <div class="col-md-6">
    <label class="form-label">Emri</label>
    <input type="text" name="name" class="form-control" required />
  </div>
  <div class="col-md-6">
    <label class="form-label">Telefoni</label>
    <input type="text" name="phone" class="form-control" required />
  </div>
  <div class="col-md-6">
    <label class="form-label">Email</label>
    <input type="email" name="email" class="form-control" />
  </div>
  <div class="col-md-3">
    <label class="form-label">Data</label>
    <input type="date" name="date" class="form-control" required />
  </div>
  <div class="col-md-3">
    <label class="form-label">Ora</label>
    <input type="time" name="time" class="form-control" required />
  </div>
  <div class="col-md-3">
    <label class="form-label">Nr. Personave</label>
    <input type="number" name="guests" class="form-control" min="1" value="2" required />
  </div>
  <div class="col-12">
    <label class="form-label">Shënime</label>
    <textarea name="notes" class="form-control"></textarea>
  </div>
  <div class="col-12">
    <div class="form-check">
      <input class="form-check-input" type="checkbox" id="payOnline" name="payOnline" value="1">
      <label class="form-check-label" for="payOnline">Paguaj paraprakisht (depozit) online</label>
    </div>
  </div>
  <div class="col-12">
    <button class="btn btn-primary" type="submit">Dërgo rezervimin</button>
    <div id="reservationResult" class="mt-3"></div>
  </div>
</form>

<%- include('partials/footer') %>
