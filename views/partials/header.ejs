<!doctype html>
<html lang="sq">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Restorant Tirana</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="/">Restorant Tirana</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbars" aria-controls="navbars" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbars">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="/">Ballina</a></li>
        <li class="nav-item"><a class="nav-link" href="/menu">Menu</a></li>
        <li class="nav-item"><a class="nav-link" href="/reservations">Rezervime</a></li>
        <li class="nav-item">
          <a class="nav-link" href="#" id="cartBtn" data-bs-toggle="modal" data-bs-target="#cartModal">Porosi <span id="cartCount" class="badge bg-secondary ms-1">0</span></a>
        </li>
        <li class="nav-item"><a class="nav-link" href="/admin">Admin</a></li>
      </ul>
    </div>
  </div>
</nav>
<!-- Cart Modal -->
<div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="cartModalLabel">Karroca</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="cartItems"></div>
        <hr/>
        <form id="checkoutForm">
          <div class="row g-2">
            <div class="col-md-6"><input name="customer_name" class="form-control" placeholder="Emri" required></div>
            <div class="col-md-6"><input name="phone" class="form-control" placeholder="Telefoni" required></div>
            <div class="col-md-12"><input name="email" class="form-control" placeholder="Email (opsionale)"></div>
            <div class="col-md-12"><input name="address" class="form-control" placeholder="Adresa për dorëzim (opsionale)"></div>
          </div>
        </form>
        <div id="checkoutResult" class="mt-2"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Mbyll</button>
        <button id="placeOrderBtn" type="button" class="btn btn-primary">Porosisni dhe Paguani</button>
      </div>
    </div>
  </div>
</div>
<main class="container my-5">
