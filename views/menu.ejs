<%- include('partials/header') %>

<h1 class="mb-4">Menu</h1>
<div class="row">
  <% if (items.length === 0) { %>
    <p>Nuk ka artikuj në menynë.</p>
  <% } %>
  <% items.forEach(function(item){ %>
    <div class="col-md-6 mb-4">
      <div class="d-flex border p-3 align-items-center">
        <img src="<%= item.image %>" alt="<%= item.name %>" style="width:120px; height:80px; object-fit:cover;" class="me-3 rounded">
        <div>
          <h5><%= item.name %> <small class="text-muted">(<%= item.category %>)</small></h5>
          <p class="mb-1"><%= item.description %></p>
          <div class="d-flex justify-content-between align-items-center">
            <strong><%= item.price %> €</strong>
            <button class="btn btn-sm btn-success add-to-cart" data-id="<%= item.id %>" data-name="<%= item.name %>" data-price="<%= item.price %>" data-image="<%= item.image %>">Shto në porosi</button>
          </div>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
